{
  "manifest_version": 3,
  "name": "Job Hunter - B0 test",
  "version": "0.6.4",
  "description": "Plan B test B0: fills the answers Job Hunter prepared and sends the application from your own Chrome. Owner-only test build.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://job-hunter.work/*",
    "https://web-production-192b7.up.railway.app/*",
    "https://*.comeet.com/*",
    "https://comeet.com/*",
    "https://*.comeet.co/*",
    "https://comeet.co/*",
    "https://jobs.lever.co/*",
    "https://jobs.eu.lever.co/*",
    "https://jobs.smartrecruiters.com/*"
  ],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Job Hunter B0",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.comeet.com/*",
        "https://comeet.com/*",
        "https://*.comeet.co/*",
        "https://comeet.co/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": [
        "page.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.comeet.com/*",
        "https://comeet.com/*",
        "https://*.comeet.co/*",
        "https://comeet.co/*",
        "https://jobs.lever.co/*",
        "https://jobs.eu.lever.co/*",
        "https://jobs.smartrecruiters.com/*"
      ],
      "js": [
        "fill.js",
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
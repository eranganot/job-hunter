# Job Hunter - environment variables.
# Copy to .env for local development (never commit .env). On Railway, set these
# in the service's Variables. Every value below is a placeholder.

# ── Core ─────────────────────────────────────────────────────────────────────
# Every AI feature (scoring, CV analysis, cover letters, tailored CVs).
GEMINI_API_KEY=
# The account registered with this address gets the admin role. Also the
# default inbox for Contact support and the web-push contact.
ADMIN_EMAIL=admin@example.com
# Public base URL, used in links inside emails and notifications.
JH_PUBLIC_URL=https://your-domain.example

# ── Database ─────────────────────────────────────────────────────────────────
# Unset = local SQLite file (development). Production: both of these.
# DB_BACKEND=postgres
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Local SQLite location (optional)
# DATABASE_PATH=./jobs.db
# Cache directory for uploaded CVs (the database is the system of record)
# UPLOADS_DIR=./uploads

# ── Security ─────────────────────────────────────────────────────────────────
# Encrypts notification credentials at rest. Generate with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JH_ENCRYPTION_KEY=
# Unlocks the detailed view of /api/health (the public view is trimmed).
JH_HEALTH_KEY=
# Session lifetime
# JH_SESSION_DAYS=30

# ── Sign-in with Google (optional) ───────────────────────────────────────────
# Google Cloud Console -> Credentials -> OAuth client ID (Web application).
# Authorized redirect URI: https://<your-domain>/auth/google/callback
# Leave empty to offer email + password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
# Sender, on a domain verified in Resend. Without it the shared sandbox sender
# is used, which can deliver only to RESEND_VERIFIED_EMAIL.
RESEND_FROM=Job Hunter <support@your-domain.example>
# The Resend account's own address (defaults to ADMIN_EMAIL)
RESEND_VERIFIED_EMAIL=
# Where Contact support messages go (defaults to RESEND_VERIFIED_EMAIL)
JH_SUPPORT_EMAIL=

# ── Web push ─────────────────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_PEM_B64=
# mailto: contact for push services (defaults to ADMIN_EMAIL)
VAPID_SUBJECT=

# ── Error reporting ──────────────────────────────────────────────────────────
JH_SENTRY_DSN=

# ── Applying ─────────────────────────────────────────────────────────────────
# The apply engine submits only when this is 1.
APPLY_ENGINE_ENABLED=0
# Try to resolve a company careers page from a job-board link (slower)
# APPLY_RESOLVE_CAREER_PAGE=0

# ── Paid job sources (shared daily pool, see paidpool.py) ───────────────────
# Comma list of sources to run: theirstack, hirebase, fantastic, apify.
# Empty = none run, whatever keys are set.
JH_PAID_POOL_SOURCES=
THEIRSTACK_API_KEY=
HIREBASE_API_KEY=
FANTASTIC_JOBS_API_KEY=
APIFY_TOKEN=
# Lower a source's cap per billing cycle (cannot exceed its free allowance
# unless JH_POOL_ALLOW_ABOVE_FREE=1)
# JH_POOL_CAP_THEIRSTACK=180

# ── Ingestion ────────────────────────────────────────────────────────────────
# Keep external jobs to the user's titles and locations before AI scoring
INGEST_RELEVANCE_GATE=1
# Optional proxies for heavy scraping
RESIDENTIAL_PROXY_URL=
PROXY_POOL=
PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_HOST=

# ── Railway-managed (set automatically) ──────────────────────────────────────
# PORT, RAILWAY_GIT_COMMIT_SHA, RAILWAY_PUBLIC_DOMAIN
